{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": true,
  "autoDreamEnabled": true,
  "enabledPlugins": {
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "context-mode@context-mode": true,
    "caveman@caveman": true
{{- else }}
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
{{- end }}
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "{{ .claude.auth_token }}",
    "ANTHROPIC_BEDROCK_BASE_URL": "{{ .claude.bedrock_url }}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SKIP_BEDROCK_AUTH": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1"
  },
{{- end }}
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "~/.claude/ccnotify/ccnotify.py Notification",
            "type": "command"
          }
        ]
      }{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }},
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
{{- end }}
    ],
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
{{- end }}
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
{{- end }}
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
{{- end }}
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/trahman/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
    "Setup": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
{{- end }}
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/.claude/ccnotify/ccnotify.py Stop",
            "type": "command"
          }
        ]
      }{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }},
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
{{- end }}
    ],
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
    ],
{{- end }}
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/.claude/ccnotify/ccnotify.py UserPromptSubmit",
            "type": "command"
          }
        ]
      }{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }},
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.llm-monitoring/scripts/claude-hook.sh",
            "async": true
          }
        ]
      }
{{- end }}
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "~/.claude/ccline/ccline",
    "padding": 0,
    "type": "command"
  }
}
