Include ~/.orbstack/ssh/config
{{- if (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}
Include ~/.ssh/config.work
{{- end }}

Host github.com
 HostName ssh.github.com
 Port 443

{{- if not (and (hasKey . "machine") (hasKey .machine "is_work") .machine.is_work) }}

Host gitlab.com-choreon
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/gitlab-choreon
    IdentitiesOnly yes
{{- end }}
